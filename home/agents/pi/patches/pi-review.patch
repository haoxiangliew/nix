+	// Pi's editor dialog plus $skill autocomplete from skill-mention. Without skill-mention, it's the
+	// plain dialog. Unlike ctx.ui.editor, it doesn't tell the terminal that pi is waiting on a dialog.
+	async function showSkillEditor(ctx: ExtensionContext, title: string): Promise<string | undefined> {
+		let skills: AutocompleteProvider | undefined;
+		pi.events.emit(SKILL_AUTOCOMPLETE_EVENT, {
+			provide: (provider: AutocompleteProvider) => {
+				skills = provider;
+			},
+		});
+
+		const provider = skills;
+
+		if (!provider) return ctx.ui.editor(title, "");
+
+		const externalEditor = pi.getSettings().externalEditor?.trim() || undefined;
+
+		return ctx.ui.custom<string | undefined>((tui, _theme, keybindings, done) => {
+			const dialog = new ExtensionEditorComponent(
+				tui,
+				keybindings,
+				title,
+				undefined,
+				done,
+				() => done(undefined),
+				undefined,
+				externalEditor,
+			);
+
+			const editor = dialog["editor"];
+			editor.setAutocompleteProvider(provider);
+			const handleInput = dialog.handleInput.bind(dialog);
+
+			// While suggestions are open, Escape closes them instead of the dialog.
+			dialog.handleInput = (data: string) =>
+				editor.isShowingAutocomplete() && isEscape(data) ? editor.handleInput(data) : handleInput(data);
+
+			return dialog;
+		});
+	}
+
+	// Loads skills named in the parts the user typed. If one fails, it tells the user and returns
+	// undefined, so the review doesn't start.
+	function loadReviewSkills(
+		ctx: ExtensionCommandContext,
+		target: ReviewTarget,
+		extraInstruction: string | undefined,
+	) {
+		const blocks = new Set<string>();
+		const expand = (text: string | undefined) => (text ? expandSkills(text, blocks) : undefined);
+
+		try {
+			return {
+				target: target.type === "custom" ? { ...target, focus: expandSkills(target.focus, blocks) } : target,
+				customInstructions: expand(reviewCustomInstructions),
+				extraInstruction: expand(extraInstruction?.trim()),
+				blocks,
+			};
+		} catch (error) {
+			const message = error instanceof Error ? error.message : String(error);
+
+			ctx.ui.notify(`A skill failed to load, so the review didn't start. ${message}`, "error");
+
+			return undefined;
+		}
+	}
+
+	// skill-mention strips the $ from skills named as $name and adds their blocks to `blocks`. Without
+	// skill-mention, the text comes back unchanged. Throws when a skill fails to load.
+	function expandSkills(text: string, blocks: Set<string>): string {
+		let result: SkillExpansion = {};
+		pi.events.emit(SKILL_EXPAND_EVENT, {
+			text,
+			done: (value: SkillExpansion) => {
+				result = value;
+			},
+		});
+
+		if (result.error !== undefined) throw new Error(result.error);
+
+		for (const block of result.blocks ?? []) blocks.add(block);
+
+		return result.text ?? text;
+	}
