+
+/** Whether a model with `score` beats the best match so far: a higher score, or the same score and a newer version. */
+function beats(score: number, m: Model<any>, bestScore: number, bestMatch: Model<any> | undefined): boolean {
+  if (score !== bestScore) {
+    return score > bestScore;
+  }
+
+  return bestMatch !== undefined && isNewer(m.id, bestMatch.id);
+}
+
+/** The id without its version numbers and date stamp: "claude-haiku" for "claude-haiku-4-5-20251001". */
+function unversioned(id: string): string {
+  return id.replace(/[-.]?\d+/g, "");
+}
+
+/** The version numbers in an id, without its date stamp: [4, 5] for "claude-haiku-4-5-20251001". */
+function versionOf(id: string): number[] {
+  return (id.match(/\d+/g) ?? []).filter(part => part.length < 8).map(Number);
+}
+
+/** Whether id `a` has a newer version than `b`, or the same version and a shorter id. */
+function isNewer(a: string, b: string): boolean {
+  const [va, vb] = [versionOf(a), versionOf(b)];
+
+  for (let i = 0; i < Math.max(va.length, vb.length); i++) {
+    const [x, y] = [va[i] ?? -1, vb[i] ?? -1];
+
+    if (x !== y) {
+      return x > y;
+    }
+  }
+
+  return a.length < b.length;
+}
